{
  "name": "@acme/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "vp install",
    "astryx": "astryx",
    "dev": "vp run web#dev",
    "format": "vp fmt --check",
    "lint": "vp lint",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "verify": "vp run format && vp run lint && vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@astryxdesign/cli": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
